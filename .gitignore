# Build-time dependencies and the workspace-local npm cache.
node_modules/
.npm-cache/

# `lib/` is deliberately NOT ignored: it is the payload, and a git install
# cannot build it (pnpm refuses a git dependency's build scripts unless the
# machine allowlists the package). Publishing rebuilds it through `prepack`, so
# the committed `lib/` is kept in step by `npm run build` before every commit.

# Editor and OS residue.
.vscode/
.DS_Store

# Local run scaffolding: the link to an isolated DSH home, and that home
# itself. It carries credentials, sessions, logs and storages, so it never
# goes into the repository.
.dsh
homes/

# Working notes and scaffolding that were never part of the released plugin:
# the build write-ups, the dated step folders, the acceptance plans and the
# screenshots taken along the way. Only the two user-facing notes in `docs/`
# are part of the repository; everything else there stays local.
PROGRESS.md
docs/*
!docs/colors.md
!docs/storage.md
